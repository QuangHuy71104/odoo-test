<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Thread" t-inherit-mode="extension">
        <xpath expr="//Message[@isTypingMessage='true']" position="attributes">
            <attribute name="t-if">chatbotService.isTyping and props.thread.chatbotTypingMessage</attribute>
        </xpath>
    </t>
</templates>
